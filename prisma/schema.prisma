generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  reminders     Reminder[]
  memories      Memory[]
  conversations Conversation[]
  notes         Note[]
  trackers      Tracker[]
  activityLogs  ActivityLog[]
  integrations  Integration[]
  automations      Automation[]
  automationRuns   AutomationRun[]
  userFiles        UserFile[]
  preferences      UserPreferences?
  calendarEvents   CalendarEvent[]
  emailCache       EmailCache[]
  emailDrafts      EmailDraft[]
  notifications    Notification[]
  agents           Agent[]
  agentRuns        AgentRun[]
  dailySummaries   DailySummary[]
  pushSubscriptions PushSubscription[]
  habits           Habit[]
  habitEntries     HabitEntry[]
  riskEntries      RiskEntry[]
  threatModels     ThreatModel[]
  goals            Goal[]
  milestones       Milestone[]
  knowledgeNodes   KnowledgeNode[]
  knowledgeEdges   KnowledgeEdge[]
  aiUsage          AIUsage[]
  apiKeys          ApiKey[]
  plugins          Plugin[]
  webhookEndpoints WebhookEndpoint[]
  agentTemplates   AgentTemplate[]
  workflowTemplates WorkflowTemplate[]
  ownedWorkspaces    SharedWorkspace[]  @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  workspaceItems     WorkspaceItem[]   @relation("WorkspaceItemAdder")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("dark")
  assistantName   String   @default("NEXUS")
  voiceEnabled    Boolean  @default(true)
  notificationsOn Boolean  @default(true)
  memoryEnabled   Boolean  @default(true)
  timezone        String   @default("UTC")
  language        String   @default("en")
  aiModel         String   @default("claude-sonnet-4-6")
  aiProvider      String   @default("anthropic")
  openaiModel     String   @default("gpt-4o")
  currentMode     String   @default("personal")
  onboardingDone  Boolean  @default(false)
  workRole        String?
  preferredName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  dueDate     DateTime?
  tags        String?
  parentId    String?
  recurring   Boolean   @default(false)
  recurrenceRule String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Task?  @relation("SubTasks", fields: [parentId], references: [id])
  subtasks Task[] @relation("SubTasks")

  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([dueDate])
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime
  status      String   @default("pending")
  priority    String   @default("medium")
  recurring   Boolean  @default(false)
  recurrenceRule String?
  snoozedUntil DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([dueAt])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  category  String
  key       String
  value     String
  source    String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, category])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  context   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolCalls      String?
  toolResults    String?
  tokens         Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  tags      String?
  pinned    Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, pinned])
}

model Tracker {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  description String?
  status      String    @default("active")
  data        String?
  dueDate     DateTime?
  amount      Float?
  currency    String?
  tags        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, status])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  details    String?
  metadata   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Integration {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  status       String    @default("disconnected")
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  metadata     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Automation {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  trigger     String
  conditions  String?
  actions     String
  status      String    @default("active")
  lastRun     DateTime?
  nextRun     DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]
}

model UserFile {
  id          String   @id @default(cuid())
  userId      String
  name        String
  originalName String
  mimeType    String
  size        Int
  path        String
  url         String?
  summary     String?
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id           String   @id @default(cuid())
  userId       String
  googleEventId String?
  title        String
  description  String?
  location     String?
  startTime    DateTime
  endTime      DateTime
  allDay       Boolean  @default(false)
  attendees    String?
  status       String   @default("confirmed")
  recurrence   String?
  meetLink     String?
  source       String   @default("nexus")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId, startTime])
}

model EmailCache {
  id          String   @id @default(cuid())
  userId      String
  gmailId     String
  threadId    String
  from        String
  fromName    String?
  to          String
  subject     String
  snippet     String?
  body        String?
  summary     String?
  labels      String?
  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  isImportant Boolean  @default(false)
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailId])
  @@index([userId, receivedAt])
}

model EmailDraft {
  id          String   @id @default(cuid())
  userId      String
  to          String
  subject     String
  body        String
  replyToId   String?
  status      String   @default("draft")
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Agent {
  id           String   @id @default(cuid())
  userId       String
  name         String
  role         String
  description  String?
  systemPrompt String?
  model        String   @default("claude-sonnet-4-6")
  tools        String?
  avatar       String?
  status       String   @default("idle")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AgentRun[]

  @@index([userId])
}

model AgentRun {
  id          String    @id @default(cuid())
  agentId     String
  userId      String
  task        String
  status      String    @default("waiting")
  output      String?
  error       String?
  metadata    String?
  toolsUsed   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  AgentLog[]

  @@index([agentId])
  @@index([userId])
}

model AgentLog {
  id        String   @id @default(cuid())
  runId     String
  type      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model DailySummary {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String
  type      String   @default("daily")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  userId       String
  status       String    @default("running")
  output       String?
  error        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([userId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String
  p256dh     String
  auth       String
  deviceName String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model Habit {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  frequency   String       @default("daily")
  targetDays  String?
  color       String       @default("#00e5ff")
  icon        String?
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@index([userId])
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String
  completed Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId, date])
}

model RiskEntry {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  category     String    @default("Technical")
  likelihood   String    @default("medium")
  impact       String    @default("medium")
  riskScore    Int       @default(0)
  status       String    @default("open")
  owner        String?
  mitigation   String?
  residualRisk String?
  framework    String?
  controlRef   String?
  dueDate      DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, framework])
}

model ThreatModel {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  system      String?
  methodology String   @default("STRIDE")
  threats     String?
  mitigations String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String      @default("personal")
  status      String      @default("active")
  targetDate  DateTime?
  progress    Int         @default(0)
  priority    String      @default("medium")
  tags        String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, category])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
}

model KnowledgeNode {
  id        String   @id @default(cuid())
  userId    String
  type      String
  entityId  String
  label     String
  metadata  String?
  createdAt DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromEdges KnowledgeEdge[]   @relation("FromNode")
  toEdges   KnowledgeEdge[]   @relation("ToNode")

  @@unique([userId, type, entityId])
  @@index([userId, type])
}

model KnowledgeEdge {
  id         String   @id @default(cuid())
  userId     String
  fromNodeId String
  toNodeId   String
  type       String
  label      String?
  weight     Float    @default(1.0)
  metadata   String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromNode KnowledgeNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   KnowledgeNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, type])
  @@index([userId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estimatedCost Float   @default(0)
  taskType     String?
  feature      String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, model])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String
  prefix      String
  permissions String    @default("read")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model Plugin {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  toolName    String
  config      String   @default("{}")
  isActive    Boolean  @default(true)
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolName])
  @@index([userId])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  userId          String
  name            String
  url             String
  events          String    @default("[]")
  secret          String?
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentTemplate {
  id           String   @id @default(cuid())
  userId       String
  name         String
  role         String
  description  String?
  systemPrompt String
  tools        String   @default("[]")
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  steps       String   @default("[]")
  trigger     String?
  isPublic    Boolean  @default(false)
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SharedWorkspace {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  type        String   @default("personal") // personal, family, work, travel, household, custom
  color       String   @default("#00d4ff")
  emoji       String   @default("🏠")
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  items   WorkspaceItem[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  email       String
  role        String    @default("viewer") // owner, editor, viewer, guest
  inviteToken String    @unique @default(cuid())
  status      String    @default("pending") // pending, active, revoked
  joinedAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace SharedWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([inviteToken])
  @@index([userId])
}

model WorkspaceItem {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String   // task, note, file, goal, reminder, calendarEvent
  entityId    String
  addedById   String
  note        String?
  createdAt   DateTime @default(now())

  workspace SharedWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addedBy   User            @relation("WorkspaceItemAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, entityId])
  @@index([workspaceId])
  @@index([addedById])
}
