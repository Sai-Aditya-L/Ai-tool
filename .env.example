# Database
DATABASE_URL="file:./prisma/dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/nexus_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Anthropic Claude API (required for AI features)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Google OAuth (required for Gmail + Calendar integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/google/callback
# Required scopes: gmail.readonly, gmail.compose, gmail.modify, calendar, calendar.events
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (for GitHub integration — repos, PRs, commits)
# Create at https://github.com/settings/applications/new
# Callback URL: {NEXTAUTH_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Web Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same-as-VAPID_PUBLIC_KEY"

# OpenAI (optional — alternative AI provider)
OPENAI_API_KEY="sk-..."

# App config
NEXT_PUBLIC_APP_NAME="NEXUS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
