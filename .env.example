# Database
DATABASE_URL="file:./prisma/dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/nexus_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Anthropic Claude API (required for AI features)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Google OAuth (required for Gmail + Calendar integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/google/callback
# Required scopes: gmail.readonly, gmail.compose, gmail.modify, calendar, calendar.events
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (optional — for GitHub login)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# App config
NEXT_PUBLIC_APP_NAME="NEXUS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
