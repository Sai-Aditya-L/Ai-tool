# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/nexus_db"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Anthropic Claude API (required for all AI features) ─────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# ─── 2FA Encryption Key (required for two-factor authentication) ──────────────
# Generate with: openssl rand -hex 32   (must be exactly 64 hex chars / 32 bytes)
ENCRYPTION_KEY="your-64-char-hex-encryption-key"

# ─── Cron / Scheduled Jobs ────────────────────────────────────────────────────
# Secures the /api/automations/run endpoint called by external schedulers
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-key"

# ─── Google OAuth + Gmail + Calendar ─────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/google/callback
# Required scopes: gmail.readonly, gmail.compose, gmail.modify, calendar, calendar.events
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create at https://github.com/settings/applications/new
# Callback URL: {NEXTAUTH_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── Spotify Integration ──────────────────────────────────────────────────────
# Create at https://developer.spotify.com/dashboard
# Redirect URI: {NEXTAUTH_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Leave blank to disable email sending (logs to console instead)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Sender address shown in outgoing emails
SMTP_FROM="NEXUS <noreply@example.com>"

# ─── Web Push Notifications ───────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same-as-VAPID_PUBLIC_KEY"

# ─── OpenAI (optional — alternative AI provider) ─────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── App config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="NEXUS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
